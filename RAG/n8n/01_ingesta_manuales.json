              },
              {
                "name": "pagina_pdf",
                "value": "={{ $json.metadata.pagina_pdf }}"
              },
              {
                "name": "pagina_libro",
                "value": "={{ $json.metadata.pagina_libro ?? '' }}"
              },
              {
                "name": "tablas",
                "value": "={{ $json.metadata.tablas.join(', ') }}"
              },
              {
                "name": "ecuaciones",
                "value": "={{ $json.metadata.ecuaciones.join(', ') }}"
              }
            ]
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Data Loader (texto + metadatos)",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        2120,
        640
      ]
    },
    {
      "parameters": {
        "chunkSize": 4000,
        "chunkOverlap": 0,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Sin re-trocear (chunks ya preparados)",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        2200,
        840
      ],
      "notes": "chunkSize 4000 > tamaño máximo de los chunks (~1.400), así que no los vuelve a partir."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT metadata->>'fuente' AS fuente,\n       count(*)              AS chunks,\n       count(DISTINCT metadata->>'pagina_pdf') AS paginas\n  FROM manuales_chunks\n GROUP BY 1\n ORDER BY 1;",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Resumen en BD",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2000,
        160
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT coalesce(array_agg(metadata->>'chunk_id'), '{}') AS existentes\n  FROM manuales_chunks\n WHERE metadata->>'fuente' = '{{ $('Config (elige fuente)').first().json.fuente.replace(/[^A-Za-z0-9_]/g, '') }}';",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000013",
      "name": "Chunks ya cargados",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        660,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Deja pasar solo los chunks que todavía no están en la base de datos\nconst ya = new Set($('Chunks ya cargados').first().json.existentes ?? []);\nconst faltan = $input.all().filter(item => !ya.has(item.json.id));\nconsole.log(`Ya cargados: ${ya.size} | Por cargar: ${faltan.length}`);\nreturn faltan;"
      },
      "id": "a1000000-0000-4000-8000-000000000014",
      "name": "Solo chunks faltantes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    }
