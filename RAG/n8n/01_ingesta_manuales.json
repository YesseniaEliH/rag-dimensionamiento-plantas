{
  "name": "RAG Plantas - 01 Ingesta de manuales (v2)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Ejecutar ingesta",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c0f1a001-0000-4000-8000-000000000001",
              "name": "fuente",
              "value": "M1_vol2",
              "type": "string"
            },
            {
              "id": "c0f1a001-0000-4000-8000-000000000003",
              "name": "modo",
              "value": "reanudar",
              "type": "string"
            },
            {
              "id": "c0f1a001-0000-4000-8000-000000000002",
              "name": "carpeta_chunks",
              "value": "C:/Users/Usuario/Documents/PROYECTOS/DIMENSIONAMIENTO DE PLANTAS/RAG/chunks",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Config (elige fuente)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "notes": "fuente: M1_vol2 -> M1_vol1 -> M2_UF -> M3_RO\nmodo: 'reanudar' (solo carga los chunks que faltan) o 'desde_cero' (borra la fuente y recarga todo)"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=CREATE EXTENSION IF NOT EXISTS vector;\n\nCREATE TABLE IF NOT EXISTS manuales_chunks (\n  id uuid NOT NULL DEFAULT gen_random_uuid() PRIMARY KEY,\n  text text,\n  metadata jsonb,\n  embedding vector(1024)\n);\n\nCREATE INDEX IF NOT EXISTS manuales_chunks_embedding_hnsw\n  ON manuales_chunks USING hnsw (embedding vector_cosine_ops);\n\nCREATE INDEX IF NOT EXISTS manuales_chunks_metadata_gin\n  ON manuales_chunks USING gin (metadata);\n\n-- Solo en modo 'desde_cero' se borran los chunks previos de la fuente\n{{ $json.modo === 'desde_cero' ? \"DELETE FROM manuales_chunks WHERE metadata->>'fuente' = '\" + $json.fuente.replace(/[^A-Za-z0-9_]/g, '') + \"';\" : 'SELECT 1;' }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Preparar tabla",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $('Config (elige fuente)').first().json.carpeta_chunks }}/{{ $('Config (elige fuente)').first().json.fuente }}.json",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Leer JSON de chunks",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        880,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "operation": "fromJson",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Parsear JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Un item por chunk",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Lotes de 10",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": "manuales_chunks",
        "embeddingBatchSize": 10,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Guardar en PGVector",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [
        2000,
        420
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "notes": "Reintenta hasta 5 veces si Postgres corta la conexión (ECONNRESET)."
    },
    {
      "parameters": {
        "model": "bge-m3:latest"
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Embeddings Ollama (bge-m3)",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [
        1900,
        640
      ]
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.texto }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "chunk_id",
                "value": "={{ $json.id }}"
              },
              {
                "name": "manual",
