              },
              {
                "name": "libro",
                "value": "={{ $json.metadata.libro }}"
              },
              {
                "name": "archivo_pdf",
                "value": "={{ $json.metadata.archivo_pdf }}"
              },
              {
                "name": "tipo_planta",
                "value": "={{ $json.metadata.tipo_planta }}"
              },
              {
                "name": "idioma",
                "value": "={{ $json.metadata.idioma }}"
              },
              {
                "name": "capitulo",
                "value": "={{ $json.metadata.capitulo }}"
              },
              {
                "name": "capitulo_titulo",
                "value": "={{ $json.metadata.capitulo_titulo }}"
              },
              {
                "name": "seccion",
