    {
      "parameters": {
        "jsCode": "const archivo = String(($json.query || {}).archivo || '');\nif (!/^[A-Za-z0-9_\\-]+\\.xlsx$/.test(archivo)) throw new Error('Nombre de archivo no válido');\nreturn [{ json: { archivo, ruta: 'C:/Users/Usuario/Documents/PROYECTOS/DIMENSIONAMIENTO DE PLANTAS/RAG/salidas/' + archivo } }];"
      },
      "id": "b5000000-0000-4000-8000-000000000002",
      "name": "Validar nombre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.ruta }}",
        "options": {}
      },
      "id": "b5000000-0000-4000-8000-000000000003",
      "name": "Leer archivo",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
